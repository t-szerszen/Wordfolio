rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isNonEmptyText(value, maxLength) {
      return isText(value, maxLength) && value.size() > 0;
    }

    function isIntBetween(value, min, max) {
      return value is int && value >= min && value <= max;
    }

    function isNumberBetween(value, min, max) {
      return value is number && value >= min && value <= max;
    }

    function isMillisOrNull(value) {
      return value == null || (value is number && value >= 0);
    }

    // updatedAt musi pochodzić z serverTimestamp(), więc klient nie może „wygrać” konfliktu
    // podając czas z przyszłości.
    function stampedNow(data) {
      return data.updatedAt == request.time;
    }

    // Przy tworzeniu createdAt nadaje serwer. Przy edycji klient odsyła wartość z lokalnej kopii,
    // która może być jeszcze szacunkiem albo stracić mikrosekundy — wymagamy więc tylko,
    // by nie wskazywała przyszłości.
    function hasCreatedAt(data) {
      return resource == null
        ? data.createdAt == request.time
        : data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidBook(bookId, data) {
      return data.keys().hasOnly([
          'title', 'author', 'lang', 'pageCount', 'fileHash', 'fileSize', 'color', 'motif',
          'page', 'bookmarks', 'lastOpenedAt', 'createdAt', 'updatedAt'])
        && data.keys().hasAll([
          'title', 'author', 'lang', 'pageCount', 'fileHash', 'fileSize', 'color', 'motif',
          'page', 'bookmarks', 'lastOpenedAt', 'createdAt', 'updatedAt'])
        && bookId.matches('^[0-9a-f]{64}$')
        && data.fileHash == bookId
        && isNonEmptyText(data.title, 300)
        && isText(data.author, 200)
        && isText(data.lang, 12)
        && isIntBetween(data.pageCount, 1, 20000)
        && isIntBetween(data.fileSize, 0, 2000000000)
        && data.color in ['clay', 'sage', 'ochre', 'rose', 'slate', 'plum', 'ink', 'linen', 'honey']
        && data.motif in ['key', 'leaf', 'star', 'moon', 'wave', 'flower', 'mountain', 'sun']
        && isIntBetween(data.page, 1, 20000)
        && data.bookmarks is list && data.bookmarks.size() <= 500
        && isMillisOrNull(data.lastOpenedAt)
        && hasCreatedAt(data)
        && stampedNow(data);
    }

    function isValidContext(context) {
      return context is map
        && context.keys().hasOnly(['sentence', 'bookId', 'bookTitle', 'page'])
        && context.keys().hasAll(['sentence', 'bookId', 'bookTitle', 'page'])
        && isText(context.sentence, 1000)
        && (context.bookId == null || isText(context.bookId, 64))
        && isText(context.bookTitle, 300)
        && (context.page == null || isIntBetween(context.page, 1, 20000));
    }

    function isValidSrs(srs) {
      return srs is map
        && srs.keys().hasOnly(['phase', 'due', 'intervalDays', 'ease', 'reps', 'lapses', 'step', 'lastReviewedAt'])
        && srs.keys().hasAll(['phase', 'due', 'intervalDays', 'ease', 'reps', 'lapses', 'step', 'lastReviewedAt'])
        && srs.phase in ['new', 'learning', 'review', 'relearning']
        && srs.due is number && srs.due >= 0
        && isNumberBetween(srs.intervalDays, 0, 36500)
        && isNumberBetween(srs.ease, 1.3, 5)
        && isIntBetween(srs.reps, 0, 100000)
        && isIntBetween(srs.lapses, 0, 100000)
        && isIntBetween(srs.step, 0, 20)
        && isMillisOrNull(srs.lastReviewedAt);
    }

    function isValidWord(wordId, data) {
      return data.keys().hasOnly([
          'term', 'lang', 'translation', 'pos', 'definition', 'ipa', 'note', 'tags', 'status',
          'context', 'srs', 'createdAt', 'updatedAt'])
        && data.keys().hasAll([
          'term', 'lang', 'translation', 'pos', 'definition', 'ipa', 'note', 'tags', 'status',
          'context', 'srs', 'createdAt', 'updatedAt'])
        && wordId.matches('^[0-9a-f]{40}$')
        && isNonEmptyText(data.term, 120)
        && isNonEmptyText(data.lang, 12)
        && isText(data.translation, 300)
        && isText(data.pos, 80)
        && isText(data.definition, 600)
        && isText(data.ipa, 80)
        && isText(data.note, 1000)
        && data.tags is list && data.tags.size() <= 20
        && data.status in ['new', 'learning', 'known']
        && isValidContext(data.context)
        && isValidSrs(data.srs)
        && hasCreatedAt(data)
        && stampedNow(data);
    }

    function isValidSettings(data) {
      return data.keys().hasOnly([
          'theme', 'fontSize', 'lineHeight', 'margins', 'showSavedWords', 'bookLang',
          'targetLang', 'reviewDays', 'updatedAt'])
        && data.keys().hasAll([
          'theme', 'fontSize', 'lineHeight', 'margins', 'showSavedWords', 'bookLang',
          'targetLang', 'reviewDays', 'updatedAt'])
        && data.theme in ['papier', 'lampka', 'system']
        && isIntBetween(data.fontSize, 14, 32)
        && isNumberBetween(data.lineHeight, 1.2, 2.2)
        && data.margins in ['narrow', 'medium', 'wide']
        && data.showSavedWords is bool
        && isNonEmptyText(data.bookLang, 12)
        && isNonEmptyText(data.targetLang, 12)
        && data.reviewDays is list && data.reviewDays.size() <= 400
        && stampedNow(data);
    }

    match /users/{uid}/books/{bookId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && isValidBook(bookId, request.resource.data);
    }

    match /users/{uid}/words/{wordId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && isValidWord(wordId, request.resource.data);
    }

    match /users/{uid}/settings/{docId} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && docId == 'main'
        && isValidSettings(request.resource.data);
    }

    // Wszystko poza users/{uid}/** jest zabronione (domyślnie brak reguły = brak dostępu).
  }
}
